# --- Required ---
GEMINI_API_KEY=<your_key_here>

# --- Auth (change JWT_SECRET in production!) ---
JWT_SECRET=change-me-to-a-long-random-string
# JWT_EXPIRE_MINUTES=10080

# --- CORS ---
# "*" is fine for local dev. In production set your frontend origin(s), comma-separated:
# CORS_ORIGINS=https://your-frontend.vercel.app
CORS_ORIGINS=*

# --- Optional: override seeded demo accounts ---
# SEED_DEMO_EMAIL=demo@rag.ai
# SEED_DEMO_PASSWORD=demo123
# SEED_ADMIN_EMAIL=admin@rag.ai
# SEED_ADMIN_PASSWORD=admin123
