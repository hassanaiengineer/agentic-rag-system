GEMINI_API_KEY=your_gemini_api_key_here

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=10080

# CORS (comma-separated origins; "*" for dev)
CORS_ORIGINS=*

# Seeded demo accounts (optional overrides)
SEED_DEMO_EMAIL=demo@rag.ai
SEED_DEMO_PASSWORD=demo123
SEED_ADMIN_EMAIL=admin@rag.ai
SEED_ADMIN_PASSWORD=admin123

# Paths (Docker/Railway volumes). SQLite defaults to a file next to the Chroma store.
BM25_PERSIST_DIR=/app/backend/data/bm25
# SQLITE_PATH=/app/backend/data/app.db
DEFAULT_TENANT_ID=system_default
MAX_GRAPH_ITERATIONS=2
